# Port for local runs (Render sets PORT itself).
PORT=3000

# PostgreSQL connection URL: the local Docker database (see README) or, in production, the Supabase session pooler
# (IPv4; Render has no outbound IPv6). TLS follows the URL. Supabase signs with its own CA, so production appends
#   ?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
# (the public Supabase Root 2021 CA, committed in certs/).
DATABASE_URL=
# Database used by test/db.test.js and test/api.test.js. Its name must end in _test; the tests drop and recreate
# every table in it.
TEST_DATABASE_URL=

# API
# Browser origins allowed to call the API, comma-separated (the Vercel frontend and local Vite).
CORS_ORIGINS=http://localhost:5173
# Bearer token for POST /api/scrape/run (cron) and POST /api/catalog/sync. Those endpoints are off without it.
CRON_SECRET=
# MANUAL_SCRAPE_COOLDOWN_MINUTES=10
# MAX_TRACKED=12

# Scraper tuning (defaults shown are sized for Render's free instance; see src/config.js).
# SCRAPER_MAX_TRIES=3
# SCRAPER_RETRY_BASE_DELAY_MS=5000
# SCRAPER_TRY_TIMEOUT_MS=120000
# SCRAPER_QUOTE_TIMEOUT_MS=60000
# STORE_REQUEST_GAP_MS=1100

# Runner tuning.
# SCHEDULER_TOLERANCE_MINUTES=5
# STALE_RUN_MINUTES=15
# RUNNER_PRODUCT_GAP_MS=4000

# Local headed runs only, if the bundled Chromium cannot start on this machine: chrome or msedge.
# SCRAPER_BROWSER_CHANNEL=chrome

# Local demos/tests only: allows --inject. Refused when NODE_ENV=production.
# ALLOW_FAULT_INJECTION=true
